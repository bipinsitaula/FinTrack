<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Field styles used by every pop-up form -->
    <Style x:Key="FL" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="FB" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style x:Key="FC" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style x:Key="FHint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- Transactions: quick add -->
    <DataTemplate x:Key="TransactionForm">
        <StackPanel>
            <UniformGrid Rows="1">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Type" Style="{StaticResource FL}"/>
                    <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Style="{StaticResource FC}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Amount (NPR)" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding Amount}" Style="{StaticResource FB}"/>
                </StackPanel>
            </UniformGrid>
            <TextBlock Text="Account" Style="{StaticResource FL}"/>
            <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}" Style="{StaticResource FC}"/>
            <TextBlock Text="Category" Style="{StaticResource FL}"/>
            <ComboBox ItemsSource="{Binding AllCategories}" SelectedItem="{Binding Category}" Style="{StaticResource FC}"/>
            <UniformGrid Rows="1">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Date (yyyy-mm-dd)" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding Date, StringFormat='yyyy-MM-dd', UpdateSourceTrigger=LostFocus}" Style="{StaticResource FB}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Note" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding Note}" Style="{StaticResource FB}"/>
                </StackPanel>
            </UniformGrid>
            <TextBlock Text="Receipt photo (optional)" Style="{StaticResource FL}"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource Ghost}" Command="{Binding BrowseReceiptCommand}" Margin="8,0,0,14"/>
                <TextBox Text="{Binding Receipt}" Style="{StaticResource FB}"/>
            </DockPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Accounts: edit (name, interest, card color) -->
    <DataTemplate x:Key="EditAccountForm">
        <StackPanel>
            <TextBlock Text="Account name" Style="{StaticResource FL}"/>
            <TextBox Text="{Binding Name}" Style="{StaticResource FB}"/>
            <TextBlock Text="Interest rate % p.a." Style="{StaticResource FL}"/>
            <TextBox Text="{Binding Rate}" Style="{StaticResource FB}"/>
            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="Use default" Style="{StaticResource Ghost}" Command="{Binding ResetCardColorCommand}" Padding="10,3" Margin="0" FontSize="12"/>
                <TextBlock Text="Card color" Style="{StaticResource FL}" Margin="0" VerticalAlignment="Center"/>
            </DockPanel>
            <ListBox Style="{StaticResource SwatchList}" ItemsSource="{Binding ColorChoices}" SelectedItem="{Binding CardColor, Mode=TwoWay}"/>
        </StackPanel>
    </DataTemplate>

    <!-- Income -->
    <DataTemplate x:Key="IncomeForm">
        <StackPanel>
            <TextBlock Text="Choose where the money went. It is added to that account's balance and to Transactions." Style="{StaticResource FHint}"/>
            <TextBlock Text="Amount (NPR)" Style="{StaticResource FL}"/>
            <TextBox Text="{Binding Amount}" Style="{StaticResource FB}"/>
            <TextBlock Text="Received into (bank, wallet or cash)" Style="{StaticResource FL}"/>
            <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}" Style="{StaticResource FC}" Margin="0,0,0,4">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}"/>
                            <TextBlock Text="{Binding TypeLabel, StringFormat='  ·  {0}'}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Style="{StaticResource Muted}" Margin="2,0,0,14" Text="{Binding Account.Balance, StringFormat='Current balance: NPR {0:N2}', FallbackValue=' ', TargetNullValue=' '}"/>
            <UniformGrid Rows="1">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Source" Style="{StaticResource FL}"/>
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Style="{StaticResource FC}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Date (yyyy-mm-dd)" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding Date, StringFormat='yyyy-MM-dd', UpdateSourceTrigger=LostFocus}" Style="{StaticResource FB}"/>
                </StackPanel>
            </UniformGrid>
            <TextBlock Text="Note (optional)" Style="{StaticResource FL}"/>
            <TextBox Text="{Binding Note}" Style="{StaticResource FB}"/>
        </StackPanel>
    </DataTemplate>

    <!-- Transactions: filters -->
    <DataTemplate x:Key="FilterForm">
        <StackPanel>
            <TextBlock Text="The list updates as you choose. Use the search bar for text." Style="{StaticResource FHint}"/>
            <TextBlock Text="Account" Style="{StaticResource FL}"/>
            <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding FilterAccount}" Style="{StaticResource FC}"/>
            <TextBlock Text="Category" Style="{StaticResource FL}"/>
            <ComboBox ItemsSource="{Binding AllCategories}" SelectedItem="{Binding FilterCategory}" Style="{StaticResource FC}"/>
            <UniformGrid Rows="1">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="From (yyyy-mm-dd)" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding FromText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FB}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="To (yyyy-mm-dd)" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding ToText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FB}"/>
                </StackPanel>
            </UniformGrid>
            <Button Content="Clear all filters" Style="{StaticResource Ghost}" Command="{Binding ClearFiltersCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
        </StackPanel>
    </DataTemplate>

    <!-- Transactions: split bill -->
    <DataTemplate x:Key="SplitForm">
        <StackPanel>
            <TextBlock Text="One bill, several categories." Style="{StaticResource FHint}"/>
            <UniformGrid Rows="1">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Account" Style="{StaticResource FL}"/>
                    <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}" Style="{StaticResource FC}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Date (yyyy-mm-dd)" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding Date, StringFormat='yyyy-MM-dd', UpdateSourceTrigger=LostFocus}" Style="{StaticResource FB}"/>
                </StackPanel>
            </UniformGrid>
            <TextBlock Text="Note" Style="{StaticResource FL}"/>
            <TextBox Text="{Binding Note}" Style="{StaticResource FB}"/>
            <TextBlock Text="Split into (category and amount)" Style="{StaticResource FL}"/>
            <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding DataContext.ExpenseCategories, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                      SelectedItem="{Binding Category}" Style="{StaticResource FC}" Margin="0,0,8,10"/>
                            <TextBox Grid.Column="1" Text="{Binding Amount}" Style="{StaticResource FB}" Margin="0,0,8,10"/>
                            <Button Grid.Column="2" Content="✕" Style="{StaticResource Danger}" Margin="0,0,0,10" Padding="10,8"
                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="+ Add line" Style="{StaticResource Soft}" Command="{Binding AddLineCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
        </StackPanel>
    </DataTemplate>

    <!-- Transactions: recurring income -->
    <DataTemplate x:Key="RecurringForm">
        <StackPanel>
            <TextBlock Text="Salary, freelance or rent received. It is posted automatically when due." Style="{StaticResource FHint}"/>
            <TextBlock Text="Name" Style="{StaticResource FL}"/>
            <TextBox Text="{Binding RecName}" Style="{StaticResource FB}"/>
            <UniformGrid Rows="1">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Amount (NPR)" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding RecAmount}" Style="{StaticResource FB}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Repeats" Style="{StaticResource FL}"/>
                    <ComboBox ItemsSource="{Binding Cycles}" SelectedItem="{Binding RecCycle}" Style="{StaticResource FC}"/>
                </StackPanel>
            </UniformGrid>
            <TextBlock Text="Paid into account" Style="{StaticResource FL}"/>
            <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding RecAccount}" Style="{StaticResource FC}"/>
            <UniformGrid Rows="1">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Category" Style="{StaticResource FL}"/>
                    <ComboBox ItemsSource="{Binding IncomeCategories}" SelectedItem="{Binding RecCategory}" Style="{StaticResource FC}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Next date" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding RecNext, StringFormat='yyyy-MM-dd', UpdateSourceTrigger=LostFocus}" Style="{StaticResource FB}"/>
                </StackPanel>
            </UniformGrid>
        </StackPanel>
    </DataTemplate>

    <!-- Budgets -->
    <DataTemplate x:Key="BudgetForm">
        <StackPanel>
            <TextBlock Text="You get warnings at 80% and 100% of the limit. Saving again for the same category updates it." Style="{StaticResource FHint}"/>
            <TextBlock Text="Category" Style="{StaticResource FL}"/>
            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Style="{StaticResource FC}"/>
            <TextBlock Text="Monthly limit (NPR)" Style="{StaticResource FL}"/>
            <TextBox Text="{Binding Limit}" Style="{StaticResource FB}"/>
        </StackPanel>
    </DataTemplate>

    <!-- Loans -->
    <DataTemplate x:Key="LoanForm">
        <StackPanel>
            <TextBlock Text="Loan name" Style="{StaticResource FL}"/>
            <TextBox Text="{Binding Name}" Style="{StaticResource FB}"/>
            <UniformGrid Rows="1">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Kind (EMI or fixed bullet)" Style="{StaticResource FL}"/>
                    <ComboBox ItemsSource="{Binding LoanKinds}" SelectedItem="{Binding Kind}" Style="{StaticResource FC}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Principal (NPR)" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding Principal, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FB}"/>
                </StackPanel>
            </UniformGrid>
            <UniformGrid Rows="1">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Interest % p.a." Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding Rate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FB}"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Tenure (months)" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding Tenure, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FB}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Start date" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding Start, StringFormat='yyyy-MM-dd', UpdateSourceTrigger=LostFocus}" Style="{StaticResource FB}"/>
                </StackPanel>
            </UniformGrid>
            <TextBlock Text="{Binding Preview}" Style="{StaticResource FHint}"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="PayInstalmentForm">
        <StackPanel>
            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" Padding="16,14" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding PayLoan.Name}" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,8">
                        <Run Text="{Binding PayInstalment.Number, Mode=OneWay, StringFormat='Instalment #{0}'}"/><Run Text="  ·  due "/><Run Text="{Binding PayInstalment.DueDate, Mode=OneWay, Converter={StaticResource DateFmt}}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding PayInstalment.Amount, StringFormat='NPR {0:N2}'}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                        <Run Text="{Binding PayInstalment.PrincipalPart, Mode=OneWay, StringFormat='Principal {0:N2}'}"/><Run Text="  ·  "/><Run Text="{Binding PayInstalment.InterestPart, Mode=OneWay, StringFormat='Interest {0:N2}'}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
            <TextBlock Text="Pay from account" Style="{StaticResource FL}"/>
            <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding PayFrom}" Style="{StaticResource FC}"/>
            <TextBlock Text="An expense is recorded in this account and the next due date moves forward." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="DebtForm">
        <StackPanel>
            <TextBlock Text="'Gave' means you lent money. 'Took' means you borrowed it." Style="{StaticResource FHint}"/>
            <UniformGrid Rows="1">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Person" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding Person}" Style="{StaticResource FB}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="You" Style="{StaticResource FL}"/>
                    <ComboBox ItemsSource="{Binding Directions}" SelectedItem="{Binding Direction}" Style="{StaticResource FC}"/>
                </StackPanel>
            </UniformGrid>
            <UniformGrid Rows="1">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Amount (NPR)" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding DebtAmount}" Style="{StaticResource FB}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Due date (optional)" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding DueText}" Style="{StaticResource FB}"/>
                </StackPanel>
            </UniformGrid>
            <TextBlock Text="Note" Style="{StaticResource FL}"/>
            <TextBox Text="{Binding DebtNote}" Style="{StaticResource FB}"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="RepayForm">
        <StackPanel>
            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedDebt.Person}" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="{Binding SelectedDebt.Outstanding, StringFormat='Outstanding: NPR {0:N2}'}" Style="{StaticResource Muted}"/>
                </StackPanel>
            </Border>
            <TextBlock Text="Amount repaid (NPR)" Style="{StaticResource FL}"/>
            <TextBox Text="{Binding RepayAmount}" Style="{StaticResource FB}"/>
        </StackPanel>
    </DataTemplate>

    <!-- Bills and insurance -->
    <DataTemplate x:Key="BillForm">
        <StackPanel>
            <TextBlock Text="Netflix, ISP, electricity, water, rent, phone recharge…" Style="{StaticResource FHint}"/>
            <TextBlock Text="Name" Style="{StaticResource FL}"/>
            <TextBox Text="{Binding Name}" Style="{StaticResource FB}"/>
            <UniformGrid Rows="1">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Amount (NPR)" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding Amount}" Style="{StaticResource FB}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Billing cycle" Style="{StaticResource FL}"/>
                    <ComboBox ItemsSource="{Binding Cycles}" SelectedItem="{Binding Cycle}" Style="{StaticResource FC}"/>
                </StackPanel>
            </UniformGrid>
            <UniformGrid Rows="1">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Next due date" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding NextDue, StringFormat='yyyy-MM-dd', UpdateSourceTrigger=LostFocus}" Style="{StaticResource FB}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Remind days before" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding Remind}" Style="{StaticResource FB}"/>
                </StackPanel>
            </UniformGrid>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="PolicyForm">
        <StackPanel>
            <UniformGrid Rows="1">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Policy" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding Policy}" Style="{StaticResource FB}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Provider" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding Provider}" Style="{StaticResource FB}"/>
                </StackPanel>
            </UniformGrid>
            <UniformGrid Rows="1">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Premium (NPR)" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding Premium}" Style="{StaticResource FB}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Paid" Style="{StaticResource FL}"/>
                    <ComboBox ItemsSource="{Binding Cycles}" SelectedItem="{Binding PremiumCycle}" Style="{StaticResource FC}"/>
                </StackPanel>
            </UniformGrid>
            <UniformGrid Rows="1">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Next due date" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding PolicyDue, StringFormat='yyyy-MM-dd', UpdateSourceTrigger=LostFocus}" Style="{StaticResource FB}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Coverage (NPR)" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding Coverage}" Style="{StaticResource FB}"/>
                </StackPanel>
            </UniformGrid>
        </StackPanel>
    </DataTemplate>

    <!-- Goals and deposits -->
    <DataTemplate x:Key="GoalForm">
        <StackPanel>
            <TextBlock Text="Laptop, trip, emergency fund…" Style="{StaticResource FHint}"/>
            <TextBlock Text="Goal name" Style="{StaticResource FL}"/>
            <TextBox Text="{Binding Name}" Style="{StaticResource FB}"/>
            <UniformGrid Rows="1">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Target (NPR)" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding Target}" Style="{StaticResource FB}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Deadline" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding Deadline, StringFormat='yyyy-MM-dd', UpdateSourceTrigger=LostFocus}" Style="{StaticResource FB}"/>
                </StackPanel>
            </UniformGrid>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ContributeForm">
        <StackPanel>
            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding Selected.Name}" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Style="{StaticResource Muted}">
                        <Run Text="{Binding Selected.Saved, Mode=OneWay, StringFormat='Saved {0:N0}'}"/><Run Text=" of "/><Run Text="{Binding Selected.Target, Mode=OneWay, StringFormat='{}{0:N0}'}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
            <TextBlock Text="Amount to add (NPR)" Style="{StaticResource FL}"/>
            <TextBox Text="{Binding Contribution}" Style="{StaticResource FB}"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="DepositForm">
        <StackPanel>
            <TextBlock Text="For a recurring deposit (RD) the amount is the monthly instalment." Style="{StaticResource FHint}"/>
            <UniformGrid Rows="1">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Name / bank" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding DepName}" Style="{StaticResource FB}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Kind" Style="{StaticResource FL}"/>
                    <ComboBox ItemsSource="{Binding DepositKinds}" SelectedItem="{Binding DepKind}" Style="{StaticResource FC}"/>
                </StackPanel>
            </UniformGrid>
            <UniformGrid Rows="1">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Amount (NPR)" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding DepAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FB}"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Rate % p.a." Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding DepRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FB}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Term (months)" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding DepTerm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FB}"/>
                </StackPanel>
            </UniformGrid>
            <TextBlock Text="Start date" Style="{StaticResource FL}"/>
            <TextBox Text="{Binding DepStart, StringFormat='yyyy-MM-dd', UpdateSourceTrigger=LostFocus}" Style="{StaticResource FB}"/>
            <TextBlock Text="{Binding DepPreview}" Style="{StaticResource FHint}"/>
        </StackPanel>
    </DataTemplate>

    <!-- Investments and tools -->
    <DataTemplate x:Key="InvestmentForm">
        <StackPanel>
            <UniformGrid Rows="1">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Name" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding Name}" Style="{StaticResource FB}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Type" Style="{StaticResource FL}"/>
                    <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" Style="{StaticResource FC}"/>
                </StackPanel>
            </UniformGrid>
            <UniformGrid Rows="1">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Purchase value (NPR)" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding Purchase}" Style="{StaticResource FB}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Current value (NPR)" Style="{StaticResource FL}"/>
                    <TextBox Text="{Binding Current}" Style="{StaticResource FB}"/>
                </StackPanel>
            </UniformGrid>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ValueForm">
        <StackPanel>
            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding Selected.Name}" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="{Binding Selected.PurchaseValue, StringFormat='Bought for NPR {0:N0}'}" Style="{StaticResource Muted}"/>
                </StackPanel>
            </Border>
            <TextBlock Text="New current value (NPR)" Style="{StaticResource FL}"/>
            <TextBox Text="{Binding NewValue}" Style="{StaticResource FB}"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="SplitBillForm">
        <StackPanel>
            <TextBlock Text="You paid the bill. Everyone else owes an equal share." Style="{StaticResource FHint}"/>
            <TextBlock Text="What for" Style="{StaticResource FL}"/>
            <TextBox Text="{Binding BillTitle}" Style="{StaticResource FB}"/>
            <TextBlock Text="Total bill (NPR)" Style="{StaticResource FL}"/>
            <TextBox Text="{Binding BillTotal}" Style="{StaticResource FB}"/>
            <TextBlock Text="Others, separated by commas" Style="{StaticResource FL}"/>
            <TextBox Text="{Binding People}" Style="{StaticResource FB}"/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
