<UserControl x:Class="FinanceTracker.Views.IncomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FinanceTracker.Controls"
             x:Name="Root">
    <StackPanel>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource LiftCard}" Padding="18,16" Margin="0,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="23" Background="{DynamicResource GoodSoftBrush}" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8C7;" FontSize="19" Foreground="{StaticResource GoodBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="THIS MONTH" Style="{StaticResource SectionLabel}" Foreground="{StaticResource GoodBrush}" Margin="0"/>
                        <ui:CountUp Value="{Binding ThisMonth}" Format="NPR {0:N0}" Style="{StaticResource Big}" FontSize="22" Foreground="{StaticResource GoodBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ui:Sparkline Grid.Column="2" Width="96" Height="52" Color="#10B981" Values="{Binding MonthTrend}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource LiftCard}" Padding="18,16" Margin="14,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="23" Background="{DynamicResource Surface2Brush}" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE787;" FontSize="19" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="LAST MONTH" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource TextBrush}" Margin="0"/>
                        <ui:CountUp Value="{Binding LastMonth}" Format="NPR {0:N0}" Style="{StaticResource Big}" FontSize="22" Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ui:Sparkline Grid.Column="2" Width="96" Height="52" Color="#64748B" Values="{Binding LastTrend}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource LiftCard}" Padding="18,16" Margin="14,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="23" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" FontSize="19" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="ALL TIME" Style="{StaticResource SectionLabel}" Foreground="{StaticResource AccentBrush}" Margin="0"/>
                        <ui:CountUp Value="{Binding Total}" Format="NPR {0:N0}" Style="{StaticResource Big}" FontSize="22" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ui:Sparkline Grid.Column="2" Width="96" Height="52" Color="#2563EB" Values="{Binding TotalTrend}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button AutomationProperties.Name="Add Income" Command="{Binding OpenAddCommand}" Height="42"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Add Income"/></StackPanel></Button>
            <Button Style="{StaticResource Danger}" Command="{Binding DeleteSelectedCommand}" Height="42" AutomationProperties.Name="Delete selected"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Delete selected"/></StackPanel></Button>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,8"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" MaxHeight="520">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="SN" Width="64" CanUserSort="False" CellTemplate="{StaticResource SnCell}"/>
                <DataGridTextColumn Header="Date" Binding="{Binding Date, Converter={StaticResource DateFmt}}" SortMemberPath="Date" Width="1.1*"/>
                <DataGridTemplateColumn Header="Received into" SortMemberPath="AccountName" Width="1.4*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Surface2Brush}" Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE825;" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AccountName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding AccountKind}" Style="{StaticResource Muted}" FontSize="11.5"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Source" Width="1.2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="14" Padding="12,4" HorizontalAlignment="Left" Background="{DynamicResource GoodSoftBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CategoryName}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding CategoryName}" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource GoodBrush}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="1.6*"/>
                <DataGridTemplateColumn Header="Amount" Width="150" HeaderStyle="{StaticResource RightHeader}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Amount, StringFormat='{}+{0:N2}'}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{StaticResource GoodBrush}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="" Width="56" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <ToggleButton x:Name="rowMenu" Style="{StaticResource MoreToggle}" HorizontalAlignment="Center" AutomationProperties.Name="Row menu" ToolTip="More">
                                    <TextBlock Text="&#x22EE;" FontSize="20" FontWeight="Bold" Margin="0,-4,0,0"/>
                                </ToggleButton>
                                <Popup IsOpen="{Binding IsChecked, ElementName=rowMenu, Mode=TwoWay}" PlacementTarget="{Binding ElementName=rowMenu}"
                                       Placement="Bottom" HorizontalOffset="-162" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Width="190" Margin="24,10,24,28" Padding="6" Background="{DynamicResource SurfaceBrush}" CornerRadius="12"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Effect="{StaticResource PopupShadow}">
                                        <Button Style="{StaticResource PopupItemDanger}" Content="Delete income" AutomationProperties.Name="Delete income"
                                                Command="{Binding DataContext.DeleteIncomeCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>
