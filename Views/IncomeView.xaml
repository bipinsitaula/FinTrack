<UserControl x:Class="FinanceTracker.Views.IncomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FinanceTracker.Controls">
    <StackPanel>
        <UniformGrid Rows="1">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="THIS MONTH" Style="{StaticResource Muted}"/>
                    <ui:CountUp Value="{Binding ThisMonth}" Format="NPR {0:N0}" Style="{StaticResource Big}" Foreground="{StaticResource GoodBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="LAST MONTH" Style="{StaticResource Muted}"/>
                    <ui:CountUp Value="{Binding LastMonth}" Format="NPR {0:N0}" Style="{StaticResource Big}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="ALL TIME" Style="{StaticResource Muted}"/>
                    <ui:CountUp Value="{Binding Total}" Format="NPR {0:N0}" Style="{StaticResource Big}" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button AutomationProperties.Name="Add Income" Command="{Binding OpenAddCommand}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Add Income"/></StackPanel></Button>
            <Button Content="Delete selected" Style="{StaticResource Danger}" Command="{Binding DeleteSelectedCommand}"/>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,8"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" MaxHeight="520">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="SN" Width="64" CanUserSort="False" CellTemplate="{StaticResource SnCell}"/>
                <DataGridTextColumn Header="Date" Binding="{Binding Date, Converter={StaticResource DateFmt}}" SortMemberPath="Date" Width="1.1*"/>
                <DataGridTextColumn Header="Received into" Binding="{Binding AccountName}" Width="1.3*"/>
                <DataGridTemplateColumn Header="Source" Width="1.2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="10,3" HorizontalAlignment="Left" Background="{StaticResource GoodSoftBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CategoryName}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding CategoryName}" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource GoodBrush}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="1.6*"/>
                <DataGridTemplateColumn Header="Amount" Width="150" HeaderStyle="{StaticResource RightHeader}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Amount, StringFormat='{}+{0:N2}'}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{StaticResource GoodBrush}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>
