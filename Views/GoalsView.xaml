<UserControl x:Class="FinanceTracker.Views.GoalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TabControl>
            <TabItem Header="Goals">
                <StackPanel>
                    <ListBox ItemsSource="{Binding Goals}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Style="{StaticResource Card}" Margin="0,0,12,10">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}">
                                            <Run Text="{Binding Saved, Mode=OneWay, StringFormat='{}{0:N0}'}"/><Run Text=" of "/><Run Text="{Binding Target, Mode=OneWay, StringFormat='{}{0:N0}'}"/><Run Text="  ·  by "/><Run Text="{Binding Deadline, Mode=OneWay, Converter={StaticResource DateFmt}}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/>
                                    </DockPanel>
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="12"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0">
                                        <Run Text="Save "/><Run Text="{Binding MonthlyNeeded, Mode=OneWay, StringFormat='{}{0:N0}'}" Foreground="{StaticResource AccentBrush}"/><Run Text=" per month to reach it on time"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button AutomationProperties.Name="New Goal" Command="{Binding OpenAddGoalCommand}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="New Goal"/></StackPanel></Button>
                        <Button AutomationProperties.Name="Add Money" Style="{StaticResource Soft}" Command="{Binding OpenContributeCommand}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Add Money"/></StackPanel></Button>
                        <Button Content="Delete goal" Style="{StaticResource Ghost}" Command="{Binding DeleteGoalCommand}"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="FD / RD">
                <StackPanel>
                    <DataGrid ItemsSource="{Binding Deposits}" SelectedItem="{Binding SelectedDeposit}" MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="SN" Width="64" CanUserSort="False" CellTemplate="{StaticResource SnCell}"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.3*"/>
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="*"/>
                            <DataGridTextColumn Header="Amount" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" Binding="{Binding Amount, StringFormat='{}{0:N0}'}" Width="*"/>
                            <DataGridTextColumn Header="Rate %" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" Binding="{Binding AnnualRate}" Width="0.6*"/>
                            <DataGridTextColumn Header="Matures" Binding="{Binding MaturityDate, Converter={StaticResource DateFmt}}" Width="*"/>
                            <DataGridTextColumn Header="Maturity amount" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" Binding="{Binding MaturityAmount, StringFormat='{}{0:N0}'}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button AutomationProperties.Name="Add Deposit" Command="{Binding OpenAddDepositCommand}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Add Deposit"/></StackPanel></Button>
                        <Button Content="Delete selected" Style="{StaticResource Ghost}" Command="{Binding DeleteDepositCommand}"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Savings rate">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Savings rate calculator" Style="{StaticResource H2}"/>
                        <TextBlock Text="Pre-filled from this month. Change the numbers to try scenarios." Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Monthly income" Style="{StaticResource Muted}" Margin="0,0,10,4"/><TextBox Text="{Binding RateIncome, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Monthly expenses" Style="{StaticResource Muted}" Margin="0,0,10,4"/><TextBox Text="{Binding RateExpense, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </WrapPanel>
                        <TextBlock Text="{Binding RateText}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
