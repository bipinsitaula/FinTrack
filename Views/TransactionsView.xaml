<UserControl x:Class="FinanceTracker.Views.TransactionsView" x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource LiftCard}" Padding="16,14" Margin="0,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top" Margin="0,2,12,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="16" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Total transactions" Style="{StaticResource Muted}" FontSize="12"/>
                        <TextBlock Text="{Binding TxCount}" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                        <TextBlock Text="Current view" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,2,0,0" Foreground="{DynamicResource FaintBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource LiftCard}" Padding="16,14" Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource GoodSoftBrush}" VerticalAlignment="Top" Margin="0,2,12,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74A;" FontSize="16" Foreground="{StaticResource GoodBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Total income" Style="{StaticResource Muted}" FontSize="12"/>
                        <TextBlock Text="{Binding FilteredIncome, StringFormat='NPR {0:N0}'}" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                        <TextBlock Text="Current view" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,2,0,0" Foreground="{DynamicResource FaintBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource LiftCard}" Padding="16,14" Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource DangerSoftBrush}" VerticalAlignment="Top" Margin="0,2,12,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74B;" FontSize="16" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Total expenses" Style="{StaticResource Muted}" FontSize="12"/>
                        <TextBlock Text="{Binding FilteredExpense, StringFormat='NPR {0:N0}'}" FontSize="20" FontWeight="Bold" Margin="0,2,0,0" Foreground="{StaticResource DangerBrush}"/>
                        <TextBlock Text="Current view" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,2,0,0" Foreground="{DynamicResource FaintBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource LiftCard}" Padding="16,14" Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top" Margin="0,2,12,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" FontSize="16" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Net balance" Style="{StaticResource Muted}" FontSize="12"/>
                        <TextBlock Text="{Binding NetBalance, StringFormat='NPR {0:N0}'}" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                        <TextBlock Text="Current view" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,2,0,0" Foreground="{DynamicResource FaintBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <TabControl>
            <TabItem Header="All transactions">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button AutomationProperties.Name="Add Transaction" Command="{Binding OpenAddCommand}" Height="42" Margin="0,0,8,8"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Add Transaction"/></StackPanel></Button>
                            <Button AutomationProperties.Name="Split Bill" Style="{StaticResource Soft}" Command="{Binding OpenSplitCommand}" Height="42" Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Split Bill"/></StackPanel></Button>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" AutomationProperties.Name="Filter" Style="{StaticResource Ghost}" Command="{Binding OpenFilterCommand}" Height="42" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE71C;" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Filter"/>
                                <Border CornerRadius="9" Background="{StaticResource AccentBrush}" MinWidth="18" Height="18" Margin="8,0,0,0" Padding="5,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveFilters}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ActiveFilters}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="21" Padding="16,0" Height="42" Margin="0,0,8,8" VerticalAlignment="Top">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE721;" FontSize="15" Foreground="{DynamicResource FaintBrush}" Margin="0,0,12,0"/>
                                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                                         Margin="0" Padding="0,10" VerticalAlignment="Center" MinWidth="0" AutomationProperties.Name="Search transactions">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <Grid>
                                                <ScrollViewer x:Name="PART_ContentHost"/>
                                                <TextBlock Text="Search by note, category, account or amount…" Foreground="{DynamicResource FaintBrush}"
                                                           IsHitTestVisible="False" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                            </DockPanel>
                        </Border>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" MaxHeight="420">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="SN" Width="64" CanUserSort="False" CellTemplate="{StaticResource SnCell}"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, Converter={StaticResource DateFmt}}" Width="110"/>
                            <DataGridTemplateColumn Header="Account" SortMemberPath="AccountName" Width="1.3*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Surface2Brush}" Margin="0,0,10,0">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE825;" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AccountName}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding AccountKind}" Style="{StaticResource Muted}" FontSize="11.5"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Category" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="14" Padding="12,4" HorizontalAlignment="Left" Background="{DynamicResource Surface2Brush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Expense">
                                                            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Income">
                                                            <Setter Property="Background" Value="{DynamicResource GoodSoftBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CategoryName}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding CategoryName}" FontSize="12.5" FontWeight="Medium">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Expense"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Income"><Setter Property="Foreground" Value="{StaticResource GoodBrush}"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="1.5*"/>
                            <DataGridTemplateColumn Header="Amount" Width="140" HeaderStyle="{StaticResource RightHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Signed, StringFormat='{}{0:+#,##0.00;-#,##0.00}'}" HorizontalAlignment="Right" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Expense">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Income">
                                                            <Setter Property="Foreground" Value="{StaticResource GoodBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="TransferIn">
                                                            <Setter Property="Foreground" Value="{StaticResource GoodBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Receipt" Width="90" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource IconButton}" Width="38" Height="38" ToolTip="Open receipt" HorizontalAlignment="Left"
                                                Command="{Binding DataContext.OpenReceiptCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                Visibility="{Binding HasReceipt, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="16"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="56" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ToggleButton x:Name="rowMenu" Style="{StaticResource MoreToggle}" HorizontalAlignment="Center" AutomationProperties.Name="Row menu" ToolTip="More">
                                                <TextBlock Text="&#x22EE;" FontSize="20" FontWeight="Bold" Margin="0,-4,0,0"/>
                                            </ToggleButton>
                                            <Popup IsOpen="{Binding IsChecked, ElementName=rowMenu, Mode=TwoWay}" PlacementTarget="{Binding ElementName=rowMenu}"
                                                   Placement="Bottom" HorizontalOffset="-162" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                                <Border Width="190" Margin="24,10,24,28" Padding="6" Background="{DynamicResource SurfaceBrush}" CornerRadius="12"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Effect="{StaticResource PopupShadow}">
                                                    <StackPanel>
                                                        <Button Style="{StaticResource PopupItem}" Content="Open receipt" Visibility="{Binding HasReceipt, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding DataContext.OpenReceiptCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                        <Button Style="{StaticResource PopupItemDanger}" Content="Delete transaction" AutomationProperties.Name="Delete transaction"
                                                                Command="{Binding DataContext.DeleteTransactionCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel>
                        
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="13" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="6,0,0,8"/>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Run Text="Income " Foreground="{DynamicResource MutedBrush}"/><Run Text="{Binding FilteredIncome, Mode=OneWay, StringFormat='{}{0:N0}'}" Foreground="{StaticResource GoodBrush}"/>
                            <Run Text="   Expenses " Foreground="{DynamicResource MutedBrush}"/><Run Text="{Binding FilteredExpense, Mode=OneWay, StringFormat='{}{0:N0}'}" Foreground="{StaticResource DangerBrush}"/>
                        </TextBlock>
                    </DockPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Recurring income">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button AutomationProperties.Name="Add Recurring Income" Command="{Binding OpenRecurringCommand}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Add Recurring Income"/></StackPanel></Button>
                        <Button Style="{StaticResource Danger}" Command="{Binding DeleteRecurringCommand}" Height="42" AutomationProperties.Name="Delete selected"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Delete selected"/></StackPanel></Button>
                        <TextBlock Text="Posted automatically when due." Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,8"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Recurring}" SelectedItem="{Binding SelectedRecurring}" MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="SN" Width="64" CanUserSort="False" CellTemplate="{StaticResource SnCell}"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Amount" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" Binding="{Binding Amount, StringFormat='{}{0:N2}'}" Width="*"/>
                            <DataGridTextColumn Header="Cycle" Binding="{Binding Cycle}" Width="*"/>
                            <DataGridTextColumn Header="Next" Binding="{Binding NextDate, Converter={StaticResource DateFmt}}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
