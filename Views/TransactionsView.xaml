<UserControl x:Class="FinanceTracker.Views.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TabControl>
            <TabItem Header="All transactions">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button AutomationProperties.Name="Add Transaction" Command="{Binding OpenAddCommand}" Height="42" Margin="0,0,8,8"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Add Transaction"/></StackPanel></Button>
                            <Button AutomationProperties.Name="Split Bill" Style="{StaticResource Soft}" Command="{Binding OpenSplitCommand}" Height="42" Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Split Bill"/></StackPanel></Button>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" AutomationProperties.Name="Filter" Style="{StaticResource Ghost}" Command="{Binding OpenFilterCommand}" Height="42" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE71C;" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Filter"/>
                                <Border CornerRadius="9" Background="{StaticResource AccentBrush}" MinWidth="18" Height="18" Margin="8,0,0,0" Padding="5,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveFilters}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ActiveFilters}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="21" Padding="16,0" Height="42" Margin="0,0,8,8" VerticalAlignment="Top">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE721;" FontSize="15" Foreground="{StaticResource FaintBrush}" Margin="0,0,12,0"/>
                                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                                         Margin="0" Padding="0,10" VerticalAlignment="Center" MinWidth="0" AutomationProperties.Name="Search transactions">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <Grid>
                                                <ScrollViewer x:Name="PART_ContentHost"/>
                                                <TextBlock Text="Search by note, category, account or amount…" Foreground="{StaticResource FaintBrush}"
                                                           IsHitTestVisible="False" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                            </DockPanel>
                        </Border>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" MaxHeight="420">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="SN" Width="64" CanUserSort="False" CellTemplate="{StaticResource SnCell}"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, Converter={StaticResource DateFmt}}" Width="110"/>
                            <DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="*"/>
                            <DataGridTemplateColumn Header="Category" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="10,3" HorizontalAlignment="Left" Background="{StaticResource Surface2Brush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CategoryName}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding CategoryName}" FontSize="12.5" FontWeight="Medium" Foreground="#334155"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="1.5*"/>
                            <DataGridTemplateColumn Header="Amount" Width="140" HeaderStyle="{StaticResource RightHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Signed, StringFormat='{}{0:+#,##0.00;-#,##0.00}'}" HorizontalAlignment="Right" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Income">
                                                            <Setter Property="Foreground" Value="{StaticResource GoodBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="TransferIn">
                                                            <Setter Property="Foreground" Value="{StaticResource GoodBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Receipt" Binding="{Binding ReceiptPath}" Width="0.6*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel>
                        <Button Content="Delete selected" Style="{StaticResource Danger}" Command="{Binding DeleteSelectedCommand}" DockPanel.Dock="Left"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="13" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="6,0,0,8"/>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Run Text="Income " Foreground="{StaticResource MutedBrush}"/><Run Text="{Binding FilteredIncome, Mode=OneWay, StringFormat='{}{0:N0}'}" Foreground="{StaticResource GoodBrush}"/>
                            <Run Text="   Expenses " Foreground="{StaticResource MutedBrush}"/><Run Text="{Binding FilteredExpense, Mode=OneWay, StringFormat='{}{0:N0}'}" Foreground="{StaticResource DangerBrush}"/>
                        </TextBlock>
                    </DockPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Recurring income">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button AutomationProperties.Name="Add Recurring Income" Command="{Binding OpenRecurringCommand}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Add Recurring Income"/></StackPanel></Button>
                        <Button Content="Delete selected" Style="{StaticResource Danger}" Command="{Binding DeleteRecurringCommand}"/>
                        <TextBlock Text="Posted automatically when due." Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,8"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Recurring}" SelectedItem="{Binding SelectedRecurring}" MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="SN" Width="64" CanUserSort="False" CellTemplate="{StaticResource SnCell}"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Amount" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" Binding="{Binding Amount, StringFormat='{}{0:N2}'}" Width="*"/>
                            <DataGridTextColumn Header="Cycle" Binding="{Binding Cycle}" Width="*"/>
                            <DataGridTextColumn Header="Next" Binding="{Binding NextDate, Converter={StaticResource DateFmt}}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
