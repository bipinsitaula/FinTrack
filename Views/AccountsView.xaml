<UserControl x:Class="FinanceTracker.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FinanceTracker.Controls"
             x:Name="Root">
    <UserControl.Resources>
        <!-- Card colours come from the account itself (its own colour, or the default for its type). -->
        <Style x:Key="AccountCard" TargetType="Border">
            <Setter Property="MinHeight" Value="196"/>
            <Setter Property="Padding" Value="22,20"/>
            <Setter Property="Margin" Value="0,0,18,18"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Background" Value="{Binding CardBackground}"/>
            <Setter Property="BorderBrush" Value="{Binding CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="TextElement.Foreground" Value="{Binding CardForeground}"/>
            <Setter Property="RenderTransform"><Setter.Value><TranslateTransform/></Setter.Value></Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5" FillBehavior="Stop"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="24" To="0" Duration="0:0:0.55" FillBehavior="Stop">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard></BeginStoryboard>
                </EventTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-5" Duration="0:0:0.18"/>
                    </Storyboard></BeginStoryboard></Trigger.EnterActions>
                    <Trigger.ExitActions><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.22"/>
                    </Storyboard></BeginStoryboard></Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Faint artwork in the corner of each card, chosen by account type. -->
        <Style x:Key="CardArt" TargetType="Path">
            <Setter Property="Data" Value="M0,80 L34,28 L52,52 L78,10 L120,80 Z"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="84"/>
            <Setter Property="Stretch" Value="Fill"/>
            <Setter Property="Fill" Value="{Binding CardForeground}"/>
            <Setter Property="Opacity" Value="0.11"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding TypeLabel}" Value="EWallet">
                    <Setter Property="Data" Value="M10,70 C8,34 40,8 100,6 C100,50 66,78 10,70 Z"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TypeLabel}" Value="Cash">
                    <Setter Property="Data" Value="M6,16 L114,16 L114,70 L6,70 Z M60,43 m-14,0 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TypeLabel}" Value="Savings">
                    <Setter Property="Data" Value="M10,70 C8,34 40,8 100,6 C100,50 66,78 10,70 Z"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TypeLabel}" Value="Current">
                    <Setter Property="Data" Value="M6,16 L114,16 L114,70 L6,70 Z M60,43 m-14,0 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TypeLabel}" Value="CreditCard">
                    <Setter Property="Data" Value="M40,45 m-34,0 a34,34 0 1,0 68,0 a34,34 0 1,0 -68,0 M80,45 m-34,0 a34,34 0 1,0 68,0 a34,34 0 1,0 -68,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterRow" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="10" Padding="12,8" Background="Transparent">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <ContentPresenter/>
                            <Border x:Name="sel" Margin="0,0,18,18" CornerRadius="18" BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="2.5" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="sel" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- KPI cards with a sparkline and month-on-month change -->
        <UniformGrid Rows="1">
            <Border Style="{StaticResource LiftCard}" Padding="20,18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconBubble}" Width="52" Height="52" CornerRadius="26" Background="{DynamicResource GoodSoftBrush}" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE825;" FontSize="22" Foreground="{StaticResource GoodBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Assets" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="13" Foreground="{DynamicResource FaintBrush}" Margin="7,1,0,0"
                                       ToolTip="Everything you own: positive account balances, deposits, investments and money owed to you."/>
                        </StackPanel>
                        <ui:CountUp Value="{Binding Assets}" Format="NPR {0:N0}" Style="{StaticResource Big}" FontSize="22" Margin="0,2,0,0"/>
                        <TextBlock FontSize="12">
                            <Run Text="{Binding AssetsKpi.ChangeText, Mode=OneWay}" Foreground="{Binding AssetsKpi.ChangeColor, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  vs last month" Foreground="{DynamicResource MutedBrush}"/>
                        </TextBlock>
                    </StackPanel>
                    <ui:Sparkline Grid.Column="2" Width="96" Height="56" Color="#10B981" Values="{Binding AssetsKpi.Trend}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource LiftCard}" Padding="20,18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconBubble}" Width="52" Height="52" CornerRadius="26" Background="{DynamicResource DangerSoftBrush}" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="22" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Liabilities" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="13" Foreground="{DynamicResource FaintBrush}" Margin="7,1,0,0"
                                       ToolTip="Everything you owe: loans, credit card balances and money you borrowed."/>
                        </StackPanel>
                        <ui:CountUp Value="{Binding Liabilities}" Format="NPR {0:N0}" Style="{StaticResource Big}" FontSize="22" Margin="0,2,0,0"/>
                        <TextBlock FontSize="12">
                            <Run Text="{Binding LiabilitiesKpi.ChangeText, Mode=OneWay}" Foreground="{Binding LiabilitiesKpi.ChangeColor, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  vs last month" Foreground="{DynamicResource MutedBrush}"/>
                        </TextBlock>
                    </StackPanel>
                    <ui:Sparkline Grid.Column="2" Width="96" Height="56" Color="#F43F5E" Values="{Binding LiabilitiesKpi.Trend}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource LiftCard}" Padding="20,18" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconBubble}" Width="52" Height="52" CornerRadius="26" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" FontSize="22" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Net worth" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="13" Foreground="{DynamicResource FaintBrush}" Margin="7,1,0,0"
                                       ToolTip="Assets minus liabilities."/>
                        </StackPanel>
                        <ui:CountUp Value="{Binding NetWorth}" Format="NPR {0:N0}" Style="{StaticResource Big}" FontSize="22" Margin="0,2,0,0"/>
                        <TextBlock FontSize="12">
                            <Run Text="{Binding NetKpi.ChangeText, Mode=OneWay}" Foreground="{Binding NetKpi.ChangeColor, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  vs last month" Foreground="{DynamicResource MutedBrush}"/>
                        </TextBlock>
                    </StackPanel>
                    <ui:Sparkline Grid.Column="2" Width="96" Height="56" Color="#2563EB" Values="{Binding NetKpi.Trend}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Toolbar: actions on the left, view toggle and sort on the right -->
        <DockPanel Margin="0,4,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,18,0">
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="3" Margin="0,0,10,8" Height="42">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegButton}" GroupName="accountview" AutomationProperties.Name="Card view" ToolTip="Card view"
                                     IsChecked="{Binding IsGridView, Mode=TwoWay}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE80A;" FontSize="15"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SegButton}" GroupName="accountview" AutomationProperties.Name="List view" ToolTip="List view"
                                     IsChecked="{Binding IsListView, Mode=TwoWay}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" FontSize="15"/>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,0,2,0" Margin="0,0,0,8" Height="42">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Sort by:" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" Width="190" Margin="0" VerticalAlignment="Center"
                                  AutomationProperties.Name="Sort accounts"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button AutomationProperties.Name="Add Account" Command="{Binding OpenAddAccountCommand}" Height="42"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Add Account"/></StackPanel></Button>
                <Button AutomationProperties.Name="Add Money" Style="{StaticResource Soft}" Command="{Binding AddMoneyCommand}" CommandParameter="{Binding Selected}" Height="42" ToolTip="Add income to the selected account (or choose one in the form)"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74B;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Add Money"/></StackPanel></Button>
                <Button AutomationProperties.Name="Transfer" Style="{StaticResource Soft}" Command="{Binding OpenTransferCommand}" Height="42"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Transfer"/></StackPanel></Button>
                <Button Style="{StaticResource Danger}" Command="{Binding DeleteAccountCommand}" CommandParameter="{Binding Selected}" Height="42" AutomationProperties.Name="Delete selected"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Delete selected"/></StackPanel></Button>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,8"/>
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
        <!-- Card view -->
        <ListBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource CardItem}" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource AccountCard}">
                        <Grid>
                            <Path Style="{StaticResource CardArt}"/>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,20">
                                    <ToggleButton x:Name="menuBtn" DockPanel.Dock="Right" Style="{StaticResource MoreToggle}" Foreground="{Binding CardForeground}"
                                                  AutomationProperties.Name="Account menu" ToolTip="More">
                                        <TextBlock Text="&#x22EE;" FontSize="22" FontWeight="Bold" Margin="0,-4,0,0"/>
                                    </ToggleButton>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=menuBtn, Mode=TwoWay}" PlacementTarget="{Binding ElementName=menuBtn}"
                                           Placement="Bottom" HorizontalOffset="-172" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                        <Border Width="196" Margin="24,10,24,28" Padding="6" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" Effect="{StaticResource PopupShadow}">
                                            <StackPanel>
                                                <Button Style="{StaticResource PopupItem}" Content="Edit and change color" AutomationProperties.Name="Edit account"
                                                        Command="{Binding DataContext.OpenEditAccountCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource PopupItem}" Content="Add money" AutomationProperties.Name="Add money to account"
                                                        Command="{Binding DataContext.AddMoneyCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource PopupItemDanger}" Content="Delete account" AutomationProperties.Name="Delete account"
                                                        Command="{Binding DataContext.DeleteAccountCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                    <Border DockPanel.Dock="Right" Margin="0,2,6,0" Padding="11,3" CornerRadius="12" Background="{Binding CardChip}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding ShareLabel}" FontSize="11.5" FontWeight="Medium"/>
                                    </Border>
                                    <Border Width="46" Height="46" CornerRadius="23" Background="{Binding CardChip}" Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE825;" FontSize="20" HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding KindLabel}" FontSize="12.5" Opacity="0.75"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding Balance, StringFormat='NPR {0:N2}'}" FontSize="30" FontWeight="Bold"/>
                                <TextBlock Margin="0,6,0,0" FontSize="12.5" Opacity="0.8">
                                    <Run Text="{Binding InterestRate, Mode=OneWay, StringFormat='Interest {0:0.0}% p.a.'}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- List view -->
        <DataGrid ItemsSource="{Binding Accounts}" SelectedItem="{Binding Selected}" MaxHeight="560"
                  Visibility="{Binding IsListView, Converter={StaticResource BoolToVis}}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="SN" Width="64" CanUserSort="False" CellTemplate="{StaticResource SnCell}"/>
                <DataGridTemplateColumn Header="Account" SortMemberPath="Name" Width="1.6*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="14" Height="14" Margin="0,0,10,0" Fill="{Binding CardBackground}" Stroke="#1A0F172A" StrokeThickness="0.5"/>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Type" Binding="{Binding KindLabel}" Width="*"/>
                <DataGridTemplateColumn Header="Balance" SortMemberPath="Balance" Width="1.2*" HeaderStyle="{StaticResource RightHeader}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Balance, StringFormat='NPR {0:N2}'}" HorizontalAlignment="Right" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShareLabel}" Value="Owed">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Interest %" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" Binding="{Binding InterestRate, StringFormat='{}{0:0.0}'}" Width="0.8*"/>
                <DataGridTextColumn Header="Share" Binding="{Binding ShareLabel}" Width="*"/>
                <DataGridTemplateColumn Header="Actions" Width="110" CanUserSort="False" HeaderStyle="{StaticResource RightHeader}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource IconButton}" Width="34" Height="34" Margin="0,0,2,0" ToolTip="Edit account" AutomationProperties.Name="Edit account row"
                                        Foreground="{StaticResource AccentBrush}" Command="{Binding DataContext.OpenEditAccountCommand, ElementName=Root}" CommandParameter="{Binding}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="15"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="34" Height="34" ToolTip="Delete account" AutomationProperties.Name="Delete account row"
                                        Foreground="{StaticResource DangerBrush}" Command="{Binding DataContext.DeleteAccountCommand, ElementName=Root}" CommandParameter="{Binding}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="15"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
