<ui:DialogBase x:Class="FinanceTracker.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:FinanceTracker.Controls"
        Title="Confirm">
    <Grid Margin="30">
        <Border Background="White" CornerRadius="18" Padding="28,26,28,22" MinWidth="400" MaxWidth="480"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Effect="{StaticResource DialogShadow}">
            <StackPanel>
                <Border x:Name="IconBubble" Width="54" Height="54" CornerRadius="27" HorizontalAlignment="Left">
                    <TextBlock x:Name="IconGlyph" Style="{StaticResource Icon}" FontSize="24" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" Margin="0,18,0,6" TextWrapping="Wrap"/>
                <TextBlock x:Name="BodyText" Style="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap" LineHeight="21"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
                    <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource Ghost}" IsCancel="True" MinWidth="96" Padding="18,10"/>
                    <Button x:Name="OkButton" IsDefault="True" Margin="0" MinWidth="110" Padding="18,10" Click="Ok_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</ui:DialogBase>
