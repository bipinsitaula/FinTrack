<ui:DialogBase x:Class="FinanceTracker.Views.FormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:FinanceTracker.Controls"
        Title="Form">
    <Grid Margin="30">
        <Border Background="White" CornerRadius="18" Padding="28,24,28,22" Width="480"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Effect="{StaticResource DialogShadow}">
            <StackPanel>
                <DockPanel Margin="0,0,0,18">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="Close_Click" ToolTip="Close" Margin="0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="14"/>
                    </Button>
                    <StackPanel>
                        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="SubtitleText" Style="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                    <ContentPresenter x:Name="Body" Margin="0,0,6,0"/>
                </ScrollViewer>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource Ghost}" IsCancel="True" MinWidth="96" Padding="18,10"/>
                    <Button x:Name="PrimaryButton" IsDefault="True" Margin="0" MinWidth="130" Padding="18,10" Click="Save_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</ui:DialogBase>
