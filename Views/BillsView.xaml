<UserControl x:Class="FinanceTracker.Views.BillsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FinanceTracker.Controls">
    <StackPanel>
        <TabControl>
            <TabItem Header="Subscriptions &amp; bills">
                <StackPanel>
                    <UniformGrid Rows="1">
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Text="PER MONTH" Style="{StaticResource Muted}"/>
                            <ui:CountUp Value="{Binding MonthlyTotal}" Format="NPR {0:N0}" Style="{StaticResource Big}" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Text="PER YEAR" Style="{StaticResource Muted}"/>
                            <ui:CountUp Value="{Binding YearlyTotal}" Format="NPR {0:N0}" Style="{StaticResource Big}"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
                            <TextBlock Text="MOST EXPENSIVE" Style="{StaticResource Muted}"/>
                            <ItemsControl ItemsSource="{Binding Top}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding MonthlyCost, StringFormat='{}{0:N0}/mo'}" Style="{StaticResource Muted}"/>
                                            <TextBlock Text="{Binding Name}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel></Border>
                    </UniformGrid>
                    <DataGrid ItemsSource="{Binding Subs}" SelectedItem="{Binding Selected}" MaxHeight="280">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="SN" Width="64" CanUserSort="False" CellTemplate="{StaticResource SnCell}"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.4*"/>
                            <DataGridTextColumn Header="Amount" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" Binding="{Binding Amount, StringFormat='{}{0:N2}'}" Width="*"/>
                            <DataGridTextColumn Header="Cycle" Binding="{Binding Cycle}" Width="*"/>
                            <DataGridTextColumn Header="Next due" Binding="{Binding NextDue, Converter={StaticResource DateFmt}}" Width="*"/>
                            <DataGridTextColumn Header="Remind (days)" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" Binding="{Binding RemindDaysBefore}" Width="*"/>
                            <DataGridTextColumn Header="Yearly cost" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" Binding="{Binding YearlyCost, StringFormat='{}{0:N0}'}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Margin="0,0,0,12">
                        <Button AutomationProperties.Name="Add Bill" Command="{Binding OpenAddBillCommand}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Add Bill"/></StackPanel></Button>
                        <ComboBox ItemsSource="{Binding Accounts}" DisplayMemberPath="Name" SelectedItem="{Binding PayFrom}" MinWidth="170"/>
                        <Button Content="Mark paid" Style="{StaticResource Soft}" Command="{Binding MarkPaidCommand}"/>
                        <Button Content="Delete" Style="{StaticResource Ghost}" Command="{Binding DeleteCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Insurance">
                <StackPanel>
                    <DataGrid ItemsSource="{Binding Policies}" SelectedItem="{Binding SelectedPolicy}" MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="SN" Width="64" CanUserSort="False" CellTemplate="{StaticResource SnCell}"/>
                            <DataGridTextColumn Header="Policy" Binding="{Binding Policy}" Width="1.3*"/>
                            <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="*"/>
                            <DataGridTextColumn Header="Premium" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" Binding="{Binding Premium, StringFormat='{}{0:N2}'}" Width="*"/>
                            <DataGridTextColumn Header="Cycle" Binding="{Binding Cycle}" Width="*"/>
                            <DataGridTextColumn Header="Due" Binding="{Binding DueDate, Converter={StaticResource DateFmt}}" Width="*"/>
                            <DataGridTextColumn Header="Coverage" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" Binding="{Binding Coverage, StringFormat='{}{0:N0}'}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Margin="0,0,0,12">
                        <Button AutomationProperties.Name="Add Policy" Command="{Binding OpenAddPolicyCommand}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Add Policy"/></StackPanel></Button>
                        <ComboBox ItemsSource="{Binding Accounts}" DisplayMemberPath="Name" SelectedItem="{Binding PayFrom}" MinWidth="170"/>
                        <Button Content="Pay premium" Style="{StaticResource Soft}" Command="{Binding PayPremiumCommand}"/>
                        <Button Content="Delete" Style="{StaticResource Ghost}" Command="{Binding DeletePolicyCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
