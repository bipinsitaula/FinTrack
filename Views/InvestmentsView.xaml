<UserControl x:Class="FinanceTracker.Views.InvestmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FinanceTracker.Controls">
    <StackPanel>
        <TabControl>
            <TabItem Header="Investments">
                <StackPanel>
                    <UniformGrid Rows="1">
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Text="PURCHASE VALUE" Style="{StaticResource Muted}"/>
                            <ui:CountUp Value="{Binding TotalPurchase}" Format="NPR {0:N0}" Style="{StaticResource Big}"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
                            <TextBlock Text="CURRENT VALUE" Style="{StaticResource Muted}"/>
                            <ui:CountUp Value="{Binding TotalCurrent}" Format="NPR {0:N0}" Style="{StaticResource Big}" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel></Border>
                    </UniformGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button AutomationProperties.Name="Add Investment" Command="{Binding OpenAddInvestmentCommand}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Add Investment"/></StackPanel></Button>
                        <Button AutomationProperties.Name="Update Value" Style="{StaticResource Soft}" Command="{Binding OpenUpdateValueCommand}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Update Value"/></StackPanel></Button>
                        <Button Content="Delete" Style="{StaticResource Danger}" Command="{Binding DeleteCommand}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="SN" Width="64" CanUserSort="False" CellTemplate="{StaticResource SnCell}"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.3*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                            <DataGridTextColumn Header="Purchase" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" Binding="{Binding PurchaseValue, StringFormat='{}{0:N0}'}" Width="*"/>
                            <DataGridTextColumn Header="Current" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" Binding="{Binding CurrentValue, StringFormat='{}{0:N0}'}" Width="*"/>
                            <DataGridTextColumn Header="Gain / loss" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" Binding="{Binding Gain, StringFormat='{}{0:N0}'}" Width="*"/>
                            <DataGridTextColumn Header="%" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" Binding="{Binding GainPct, StringFormat='{}{0:N1}'}" Width="0.6*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>

            <TabItem Header="Tax helper">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Yearly income and deductions" Style="{StaticResource H2}"/>
                        <TextBlock Text="Deductible categories (education, health, insurance) are flagged in the category list. This is a summary, not tax advice; check the current rules with a tax professional." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <StackPanel><TextBlock Text="{Binding TaxYearLabel}" Style="{StaticResource Muted}" Margin="0,0,10,4"/><TextBox Text="{Binding TaxYear, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" MinWidth="90"/></StackPanel>
                        <UniformGrid Rows="1">
                            <StackPanel><TextBlock Text="Total income" Style="{StaticResource Muted}" Margin="0,0,10,4"/><TextBlock Text="{Binding TaxIncome, StringFormat='{}{0:N0}'}" Style="{StaticResource Big}" Foreground="{StaticResource GoodBrush}"/></StackPanel>
                            <StackPanel><TextBlock Text="Deductions" Style="{StaticResource Muted}" Margin="0,0,10,4"/><TextBlock Text="{Binding TaxDeductions, StringFormat='{}{0:N0}'}" Style="{StaticResource Big}"/></StackPanel>
                            <StackPanel><TextBlock Text="Taxable (estimate)" Style="{StaticResource Muted}" Margin="0,0,10,4"/><TextBlock Text="{Binding Taxable, StringFormat='{}{0:N0}'}" Style="{StaticResource Big}" Foreground="{StaticResource AccentBrush}"/></StackPanel>
                        </UniformGrid>
                        <DataGrid ItemsSource="{Binding TaxLines}" Margin="0,12,0,0" MaxHeight="220">
                            <DataGrid.Columns>
                            <DataGridTemplateColumn Header="SN" Width="64" CanUserSort="False" CellTemplate="{StaticResource SnCell}"/>
                                <DataGridTextColumn Header="Deduction" Binding="{Binding Item}" Width="2*"/>
                                <DataGridTextColumn Header="Amount" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" Binding="{Binding Amount, StringFormat='{}{0:N2}'}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="Bill splitting">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Who owes you after a group dinner" Style="{StaticResource H2}"/>
                        <TextBlock Text="Split a bill equally. Each person's share is added to Loans, Friends &amp; family so you can track who still owes you."
                                   Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <Button AutomationProperties.Name="Split a Bill" Command="{Binding OpenSplitBillCommand}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Split a Bill"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding SplitResult}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="Currency converter">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="NPR · USD · INR" Style="{StaticResource H2}"/>
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Amount" Style="{StaticResource Muted}" Margin="0,0,10,4"/><TextBox Text="{Binding FxAmount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="From" Style="{StaticResource Muted}" Margin="0,0,10,4"/><ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding FxFrom}" MinWidth="90"/></StackPanel>
                            <StackPanel><TextBlock Text="To" Style="{StaticResource Muted}" Margin="0,0,10,4"/><ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding FxTo}" MinWidth="90"/></StackPanel>
                        </WrapPanel>
                        <TextBlock Text="{Binding FxResult}" Style="{StaticResource Big}" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Rates are stored locally (offline). Update them under Settings &amp; Backup." Style="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
