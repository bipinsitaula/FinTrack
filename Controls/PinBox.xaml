<UserControl x:Class="FinanceTracker.Controls.PinBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <PasswordBox x:Name="Masked" Margin="0" MinWidth="0" Padding="12,10,46,10"
                     FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     HorizontalContentAlignment="{Binding InputAlignment, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     PasswordChanged="Masked_PasswordChanged"/>
        <TextBox x:Name="Plain" Margin="0" MinWidth="0" Padding="12,10,46,10" Visibility="Collapsed"
                 FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 HorizontalContentAlignment="{Binding InputAlignment, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 TextChanged="Plain_TextChanged"/>
        <ToggleButton x:Name="Eye" HorizontalAlignment="Right" Width="42" Focusable="False" Cursor="Hand"
                      ToolTip="Show or hide the PIN" AutomationProperties.Name="Show PIN" Checked="Eye_Click" Unchecked="Eye_Click"
                      Foreground="{StaticResource MutedBrush}">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" CornerRadius="10">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="glyph" Style="{StaticResource Icon}" Text="&#xE7B3;" FontSize="17" Foreground="{TemplateBinding Foreground}"/>
                            <Path x:Name="slash" Data="M2,18 L20,2" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" Width="22" Height="20"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="slash" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="slash" Property="Stroke" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource InkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>
    </Grid>
</UserControl>
