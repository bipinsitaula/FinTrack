<Window x:Class="FinanceTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FinanceTracker.ViewModels"
        Title="FinTrack" Icon="/Assets/app.ico" Width="1360" Height="860" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <vm:PageEqualsConverter x:Key="PageIs"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="Nav" TargetType="RadioButton" BasedOn="{StaticResource NavButton}">
            <Setter Property="GroupName" Value="nav"/>
        </Style>

        <!-- Translucent "glass" button used for the profile card at the bottom of the sidebar -->
        <Style x:Key="GlassCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="16" Padding="14,12" Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0D2557" Offset="0"/>
                    <GradientStop Color="#0A1D47" Offset="0.55"/>
                    <GradientStop Color="#08173A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <!-- faint mountain silhouette behind the lower part of the sidebar -->
                <Path VerticalAlignment="Bottom" Stretch="Fill" Height="150" IsHitTestVisible="False" Opacity="0.55"
                      Data="M0,150 L0,95 L46,52 L84,82 L136,30 L190,86 L232,60 L272,92 L272,150 Z">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1F3F78" Offset="0"/>
                            <GradientStop Color="#0A1D47" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>

                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="92" Margin="24,6,0,0">
                        <Image Source="/Assets/logo-mark.png" Height="50" Width="50" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="25" FontWeight="Bold">
                                <Run Text="Fin" Foreground="White"/><Run Text="Track" Foreground="#2DD4BF"/>
                            </TextBlock>
                            <TextBlock Text="Track  •  Manage  •  Grow" FontSize="11" Foreground="#8FA3C8" Margin="1,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Button DockPanel.Dock="Bottom" Style="{StaticResource GlassCard}" Margin="14,0,14,16" Command="{Binding ShowProfileCommand}"
                            AutomationProperties.Name="Profile and settings" ToolTip="Open your profile and settings">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Margin="0,0,12,0">
                                <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource AccentBrush}">
                                    <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="17"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Ellipse Width="12" Height="12" Fill="#22C55E" Stroke="#0A1D47" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Offline · stored on this PC" FontSize="11.5" Foreground="#9DB0D3" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="13" Foreground="#B7C5E3" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,4,0,12">
                            <RadioButton Style="{StaticResource Nav}" IsChecked="{Binding Page, Mode=TwoWay, Converter={StaticResource PageIs}, ConverterParameter=Dashboard}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" Width="30"/><TextBlock Text="Dashboard"/></StackPanel>
                            </RadioButton>

                            <TextBlock Text="MONEY" Style="{StaticResource SectionLabel}" Margin="26,18,0,6"/>
                            <RadioButton Style="{StaticResource Nav}" IsChecked="{Binding Page, Mode=TwoWay, Converter={StaticResource PageIs}, ConverterParameter=Accounts}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE825;" Width="30"/><TextBlock Text="Accounts"/></StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource Nav}" IsChecked="{Binding Page, Mode=TwoWay, Converter={StaticResource PageIs}, ConverterParameter=Transactions}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" Width="30"/><TextBlock Text="Transactions"/></StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource Nav}" IsChecked="{Binding Page, Mode=TwoWay, Converter={StaticResource PageIs}, ConverterParameter=Income}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74B;" Width="30"/><TextBlock Text="Income"/></StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource Nav}" IsChecked="{Binding Page, Mode=TwoWay, Converter={StaticResource PageIs}, ConverterParameter=Budgets}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" Width="30"/><TextBlock Text="Budgets"/></StackPanel>
                            </RadioButton>

                            <TextBlock Text="FINANCE" Style="{StaticResource SectionLabel}" Margin="26,18,0,6"/>
                            <RadioButton Style="{StaticResource Nav}" IsChecked="{Binding Page, Mode=TwoWay, Converter={StaticResource PageIs}, ConverterParameter=Loans}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C7;" Width="30"/><TextBlock Text="Loans &amp; Debts"/></StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource Nav}" IsChecked="{Binding Page, Mode=TwoWay, Converter={StaticResource PageIs}, ConverterParameter=Bills}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Width="30"/><TextBlock Text="Bills &amp; Insurance"/></StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource Nav}" IsChecked="{Binding Page, Mode=TwoWay, Converter={StaticResource PageIs}, ConverterParameter=Goals}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE734;" Width="30"/><TextBlock Text="Savings &amp; Goals"/></StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource Nav}" IsChecked="{Binding Page, Mode=TwoWay, Converter={StaticResource PageIs}, ConverterParameter=Invest}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" Width="30"/><TextBlock Text="Investments &amp; Tools"/></StackPanel>
                            </RadioButton>

                            <TextBlock Text="GENERAL" Style="{StaticResource SectionLabel}" Margin="26,18,0,6"/>
                            <RadioButton Style="{StaticResource Nav}" IsChecked="{Binding Page, Mode=TwoWay, Converter={StaticResource PageIs}, ConverterParameter=Insights}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE82F;" Width="30"/><TextBlock Text="Insights"/></StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource Nav}" IsChecked="{Binding Page, Mode=TwoWay, Converter={StaticResource PageIs}, ConverterParameter=Settings}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Width="30"/><TextBlock Text="Settings &amp; Backup"/></StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Content area -->
        <Grid Grid.Column="1" Background="{DynamicResource BgBrush}" TextElement.Foreground="{DynamicResource TextBrush}">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top header -->
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="32,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="18" Padding="3" Margin="0,0,14,0" VerticalAlignment="Center"
                                ToolTip="Show dates in English (AD) or Nepali (BS) calendar">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegButton}" GroupName="calendar" Content="AD" AutomationProperties.Name="AD calendar"
                                             IsChecked="{Binding Calendar, Mode=TwoWay, Converter={StaticResource PageIs}, ConverterParameter=AD}"/>
                                <RadioButton Style="{StaticResource SegButton}" GroupName="calendar" Content="BS" AutomationProperties.Name="BS calendar"
                                             IsChecked="{Binding Calendar, Mode=TwoWay, Converter={StaticResource PageIs}, ConverterParameter=BS}"/>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource IconButton}" Command="{Binding ToggleThemeCommand}" Margin="0,0,8,0" AutomationProperties.Name="Toggle theme"
                                ToolTip="Switch between light and dark mode">
                            <TextBlock FontSize="20">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Text" Value="&#xE708;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDark}" Value="True">
                                                <Setter Property="Text" Value="&#xE706;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding ShowAlertsCommand}" ToolTip="Alerts" Margin="0,0,8,0">
                            <Grid>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEA8F;" FontSize="20"/>
                                <Ellipse Width="10" Height="10" Fill="#F43F5E" Stroke="{DynamicResource SurfaceBrush}" StrokeThickness="2"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0"
                                         RenderTransformOrigin="0.5,0.5"
                                         Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVis}}">
                                    <Ellipse.RenderTransform><ScaleTransform x:Name="pulse"/></Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetName="pulse" Storyboard.TargetProperty="ScaleX" From="1" To="1.45" Duration="0:0:0.8"/>
                                                <DoubleAnimation Storyboard.TargetName="pulse" Storyboard.TargetProperty="ScaleY" From="1" To="1.45" Duration="0:0:0.8"/>
                                            </Storyboard></BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource InkPill}" Command="{Binding LogoutCommand}" AutomationProperties.Name="Log out" ToolTip="Lock the app and return to the login screen">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Log out"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="22" Padding="18,0,10,0" Height="46" Width="520" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Effect="{StaticResource CardShadow}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Press Ctrl + K to jump to search">
                                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="6" Padding="7,2"><TextBlock Text="Ctrl" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></Border>
                                <TextBlock Text="+" FontSize="11" Foreground="{DynamicResource FaintBrush}" Margin="5,0" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="6" Padding="8,2"><TextBlock Text="K" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></Border>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE721;" FontSize="15" Foreground="{DynamicResource FaintBrush}" Margin="0,0,12,0"/>
                            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                                     Margin="0,0,10,0" Padding="0,10" VerticalAlignment="Center" MinWidth="0" AutomationProperties.Name="Search">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                </TextBox.InputBindings>
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Grid>
                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                            <TextBlock Text="Search transactions, then press Enter…" Foreground="{DynamicResource FaintBrush}"
                                                       IsHitTestVisible="False" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Page -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,26,16,28">
                <StackPanel>
                    <Grid Margin="0,0,16,22">
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" FontSize="34" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="14.5" Margin="0,4,0,12"/>
                            <Border Width="46" Height="4" CornerRadius="2" HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#10B981" Offset="0"/>
                                        <GradientStop Color="#2563EB" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </StackPanel>

                        <!-- soft decorative artwork in the corner -->
                        <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="400" Height="116" IsHitTestVisible="False" Margin="0,-6,0,0">
                            <Path Data="M150,116 L215,50 L248,78 L300,12 L352,66 L378,44 L400,64 L400,116 Z">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#C7D9F1" Offset="0"/>
                                        <GradientStop Color="#EAF2FB" Offset="1"/>
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                            <Path Data="M270,34 L300,12 L322,40 L306,34 L296,44 Z" Fill="#F4F8FD"/>
                            <Path Data="M205,116 L262,62 L300,92 L336,56 L400,116 Z" Fill="#DCE8F7" Opacity="0.85"/>
                            <Path Data="M360,116 L368,70 L376,116 Z M374,116 L383,56 L392,116 Z M388,116 L396,78 L400,116 Z" Fill="#9FBFC0" Opacity="0.8"/>
                            <TextBlock Canvas.Left="24" Canvas.Top="26" FontFamily="Segoe Script, Segoe UI" FontStyle="Italic" FontSize="14.5" Foreground="#5F7AA3"
                                       LineHeight="22" Text="Better habits.&#10;A brighter tomorrow.">
                                <TextBlock.RenderTransform><RotateTransform Angle="-5"/></TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Canvas.Left="196" Canvas.Top="14" Text="&#x2197;" FontSize="26" FontWeight="Bold" Foreground="#10B981"/>
                        </Canvas>
                    </Grid>
                    <ContentControl Content="{Binding Current}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border x:Name="Scrim" Grid.ColumnSpan="2" Background="#990F172A" Visibility="Collapsed" IsHitTestVisible="False"/>
    </Grid>
</Window>
