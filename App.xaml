<Application x:Class="FinanceTracker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FinanceTracker.ViewModels"
             xmlns:v="clr-namespace:FinanceTracker.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
                <ResourceDictionary Source="Themes/Forms.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <vm:RowNumberConverter x:Key="RowNumber"/>

            <DataTemplate x:Key="SnCell">
                <TextBlock Foreground="{DynamicResource FaintBrush}" FontWeight="Medium" FontSize="12.5"
                           Text="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource RowNumber}}"/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AccountsViewModel}"><v:AccountsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:TransactionsViewModel}"><v:TransactionsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:IncomeViewModel}"><v:IncomeView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:BudgetsViewModel}"><v:BudgetsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:LoansViewModel}"><v:LoansView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:BillsViewModel}"><v:BillsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:GoalsViewModel}"><v:GoalsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:InvestmentsViewModel}"><v:InvestmentsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:InsightsViewModel}"><v:InsightsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
